# Copy to .env and fill in. Never commit .env.
# Meta Model API key — https://api.meta.ai/v1 (OpenAI-SDK compatible)
MODEL_API_KEY=

# --- Production / deploy (ADR 0014). All optional. ---
# HOST=0.0.0.0            # bind address (default 127.0.0.1; the Docker image sets 0.0.0.0)
# PORT=8787               # one port serves the client and the WebSocket
# TRUST_PROXY=1           # behind a proxy: take the visitor IP from X-Forwarded-For (per-visitor budgets)
# DATA_DIR=data           # saved worlds + spend counters (mount a volume here)
# ALLOWED_ORIGINS=https://your.domain   # comma list; unset = any origin
# MAX_CONN_PER_IP=10
# AI_KILL_SWITCH=1        # turn every Meta call off at once (visitor mode: play + demo worlds)
# Spend guard, per visitor IP and globally, per UTC day (voice in minutes of Meta session time):
# BUDGET_SESSION_BUILDS=20  BUDGET_SESSION_IMAGES=24 BUDGET_SESSION_SAM=6  BUDGET_SESSION_VOICE_MIN=8
# BUDGET_GLOBAL_BUILDS=400  BUDGET_GLOBAL_IMAGES=300 BUDGET_GLOBAL_SAM=100 BUDGET_GLOBAL_VOICE_MIN=120

# Optional: run the command router on Muse Spark Open (open weights) via Baseten (ADR 0032).
# Unset = hosted Muse Spark. Falls back to hosted Spark on error/timeout.
# BASETEN_API_KEY=
# BASETEN_MODEL=meta-models/muse-spark-open-1026
# BASETEN_TIMEOUT_MS=4000
