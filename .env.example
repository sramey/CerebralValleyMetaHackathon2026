# Copy to .env and fill in. Never commit .env.
# Meta Model API key — https://api.meta.ai/v1 (OpenAI-SDK compatible)
# A MODEL_API_KEY already set in your shell wins over this file. The server prints
# "Meta key: found" or "Meta key: not set" at startup, so you can check it took.
MODEL_API_KEY=

# How many parts of a compound command ("add a dragon and make it rain") Wonder builds at once.
# MAX_PARALLEL=4

# --- Local development (two terminals: `npm run dev` + `npm run server`). All optional. ---
# The production build ignores these: `npm run build && npm start` serves client and WebSocket on one port.
# VITE_PORT=5173                     # Vite's dev port (default 5173)
# VITE_WS_URL=ws://127.0.0.1:8787    # where the dev client finds the game server (default 8787)
# Set PORT below if 8787 is taken, then point VITE_WS_URL at the same port. Worktrees use one pair each.

# --- Production / deploy (ADR 0014). All optional. ---
# HOST=0.0.0.0            # bind address (default 127.0.0.1; the Docker image sets 0.0.0.0)
# PORT=8787               # one port serves the client and the WebSocket
# TRUST_PROXY=1           # behind a proxy: take the visitor IP from X-Forwarded-For (per-visitor budgets)
# DATA_DIR=data           # saved worlds + spend counters (mount a volume here)
# ALLOWED_ORIGINS=https://your.domain   # comma list; unset = any origin
# MAX_CONN_PER_IP=10
# AI_KILL_SWITCH=1        # turn every Meta call off at once (visitor mode: play + demo worlds)
# Spend guard, per visitor IP and globally, per UTC day (voice in minutes of Meta session time).
# Unlimited by default: there is no public page and every player brings their own Meta key, so a
# local build is never capped. Set any of these only to put a limit back (e.g. a hosted demo).
# Unset or empty = unlimited.
# BUDGET_SESSION_BUILDS=  BUDGET_SESSION_IMAGES=  BUDGET_SESSION_SAM=  BUDGET_SESSION_VOICE_MIN=
# BUDGET_GLOBAL_BUILDS=   BUDGET_GLOBAL_IMAGES=   BUDGET_GLOBAL_SAM=   BUDGET_GLOBAL_VOICE_MIN=
# "How does this work?" explanations have their own bucket, so clicking things to learn never eats builds (ADR 0043):
# BUDGET_SESSION_EXPLAINS=  BUDGET_GLOBAL_EXPLAINS=

# Optional: run the command router on Muse Spark Open (open weights) via Baseten (ADR 0032).
# Unset = hosted Muse Spark. Falls back to hosted Spark on error/timeout.
# BASETEN_API_KEY=
# BASETEN_MODEL=meta-models/muse-spark-open-1026
# BASETEN_TIMEOUT_MS=4000

# --- Kid-safe screen (ADR 0044). On by default. ---
# SAFETY=on                 # off = no screen at all (demo comparisons, local experiments)
# SAFETY_BUDGET_MS=400      # deadline for screening a build command; a miss lets the request through
# SAFETY_ART_BUDGET_MS=2000 # longer deadline for image prompts (art is async anyway)
