{
  "name": "metabuild",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "description": "Talk-to-build platformer: you talk, AI writes verified mods, they hot-load live.",
  "scripts": {
    "dev": "vite",
    "server": "tsx server/index.ts",
    "start": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "stats": "tsx scripts/stats.ts",
    "testers": "tsx scripts/testers.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "rehearse": "tsx scripts/rehearse.ts",
    "safety:rehearse": "tsx scripts/safety-rehearse.ts",
    "demo:prep": "tsx scripts/demo-prep.ts",
    "bench:router": "tsx scripts/bench-router.ts",
    "cold:check": "tsx scripts/cold-start-check.ts"
  },
  "dependencies": {
    "esbuild": "^0.25.0",
    "pixi.js": "^8.6.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
